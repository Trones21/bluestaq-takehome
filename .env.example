# Local development. Copy to .env; never commit real values.
PORT=8080
ADMIN_PORT=9090
DATABASE_URL=postgres://notes:notes@localhost:5433/notes?sslmode=disable
# 32+ bytes; the service refuses to start on anything shorter.
JWT_SECRET=dev-only-secret-not-for-production-32
JWT_TTL=24h
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=notes-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE=true
