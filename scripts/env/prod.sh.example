#!/usr/bin/env bash
# Production environment TEMPLATE.
#
# Copy this OUTSIDE the repository -- the real file belongs at
# ~/env_setup/notes/prod.sh, which is where generate_dot_env_prod.sh looks for
# it. It is never committed, and scripts/env/prod.sh is gitignored so a stray
# copy inside the repo cannot be committed either.
#
#   mkdir -p ~/env_setup/notes
#   cp scripts/env/prod.sh.example ~/env_setup/notes/prod.sh
#   chmod 600 ~/env_setup/notes/prod.sh
#   $EDITOR ~/env_setup/notes/prod.sh
#
# Secrets are read from `pass` rather than written inline, so this file can be
# read without exposing anything. Its ceiling is honest and worth stating: the
# decrypted values still pass through a laptop and land in a .env_prod that is
# scp'd to the host. The upgrade is SSM Parameter Store or Secrets Manager with
# an IAM-scoped instance role, so secrets are never at rest outside AWS.

export ENV=production

export PORT=8080
export ADMIN_PORT=9090

# RDS. Require TLS in production -- sslmode=disable here would put credentials
# and note contents on the wire in plaintext.
export DATABASE_URL="postgres://notes:$(pass show notes/db-password)@notes-db.abc123.us-east-1.rds.amazonaws.com:5432/notes?sslmode=require"
export DB_MAX_CONNS=20

export JWT_SECRET="$(pass show notes/jwt-secret)"
export JWT_TTL=24h

export LOG_LEVEL=info
export CORS_ALLOWED_ORIGINS="https://notes.example.com"

# Real S3: no endpoint override, and virtual-host addressing rather than the
# path-style MinIO requires.
export S3_REGION=us-east-1
export S3_BUCKET=notes-attachments-prod
export S3_ACCESS_KEY="$(pass show notes/s3-access-key)"
export S3_SECRET_KEY="$(pass show notes/s3-secret-key)"
export S3_PATH_STYLE=false
export S3_UPLOAD_TTL=15m
export S3_DOWNLOAD_TTL=1h
export MAX_ATTACHMENT_MB=100

# Deploy target, read by scripts/deploy.sh.
export SERVER="notes@api.notes.example.com"
export APP_HOST="api.notes.example.com"
export ACME_EMAIL="ops@notes.example.com"
